{
  "run": {
    "results_dir": "results",
    "repeats": 3,
    "warmup": 1,
    "timeout_s": 7200,
    "verify_proofs": "all",
    "fail_fast": false
  },
  "functional": {
    "protocols": ["groth16", "plonk", "stark"],
    "circuits": ["matmul", "fibonacci", "poseidon", "sql"],
    "platforms": ["cpu", "cuda", "hip"],
    "density": "full",
    "sizes": {
      "matmul": 16,
      "fibonacci": 1024,
      "poseidon": 8,
      "sql": 16
    },
    "repeats": 3,
    "stark_profiles": {
      "cpu_threads": 1,
      "dcu_sim_threads": 3,
      "gpu_sim_threads": 4
    }
  },
  "performance": {
    "protocol": "groth16",
    "circuits": ["matmul", "fibonacci", "poseidon", "sql"],
    "densities": ["full", "hybrid", "sparse"],
    "k_bits": [20, 21, 22, 23, 24, 25, 26],
    "repeats": 3,
    "cpu_reference": "single_machine_single_thread",
    "p1": {
      "concurrency": "auto",
      "max_concurrency": 16
    },
    "p2": {
      "devices": {"cuda": 4, "hip": 8},
      "concurrency": "auto",
      "max_concurrency": 8
    },
    "p3": {
      "proof_bits": 26,
      "equivalent_bits": 30,
      "nodes": {"cuda": 3, "hip": 2},
      "devices_per_node": {"cuda": 4, "hip": 8},
      "waves_per_card": 16,
      "concurrency": 1
    }
  },
  "setup": {
    "reuse": false,
    "per_case": true,
    "per_node": true
  },
  "utilization": {
    "target": 0.90,
    "sample_ms": 100,
    "trim_ratio": 0.10,
    "qualification": "gate"
  },
  "platforms": {
    "cpu": {
      "kind": "cpu",
      "groth16_bin": "build/groth16/bin",
      "groth16_data": "build/groth16/data",
      "plonk_bin": "build/plonk/bin",
      "plonk_data": "build/plonk/data",
      "stark_bin": "protocols/stark/winterfell/target/release/winterfell"
    },
    "cuda": {
      "kind": "cuda",
      "groth16_bin": "build/groth16/bin",
      "groth16_data": "build/groth16/data",
      "plonk_bin": "build/plonk/bin",
      "plonk_data": "build/plonk/data",
      "stark_bin": "protocols/stark/winterfell/target/release/winterfell"
    },
    "hip": {
      "kind": "hip",
      "groth16_bin": "build/groth16/bin",
      "groth16_data": "build/groth16/data",
      "plonk_bin": "build/plonk/bin",
      "plonk_data": "build/plonk/data",
      "stark_bin": "protocols/stark/winterfell/target/release/winterfell"
    }
  },
  "deployments": {
    "cpu": {"platform": "cpu", "nodes": ["local"], "devices": 1, "concurrency": 1},
    "cuda_1": {"platform": "cuda", "nodes": ["local"], "devices": 1, "concurrency": "auto"},
    "hip_1": {"platform": "hip", "nodes": ["local"], "devices": 1, "concurrency": "auto"},
    "cuda_4": {"platform": "cuda", "nodes": ["local"], "devices": 4, "concurrency": "auto"},
    "hip_8": {"platform": "hip", "nodes": ["local"], "devices": 8, "concurrency": "auto"},
    "cuda_3x4": {
      "platform": "cuda",
      "nodes": ["gpu01", "gpu02", "gpu03"],
      "devices": 4,
      "concurrency": 1
    },
    "hip_2x8": {
      "platform": "hip",
      "nodes": ["dcu01", "dcu02"],
      "devices": 8,
      "concurrency": 1
    }
  }
}
